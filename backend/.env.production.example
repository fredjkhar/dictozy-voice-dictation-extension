XAI_API_KEY=replace_with_your_xai_api_key
XAI_API_BASE_URL=https://api.x.ai
APP_ENV=production
BACKEND_CORS_ORIGINS=chrome-extension://folpeencabfejhjokmldikaelonphmma
TRANSCRIPTION_ENABLED=false
TRANSCRIBE_MAX_CONCURRENT_REQUESTS=2
TRANSCRIBE_RATE_LIMIT_REQUESTS=30
TRANSCRIBE_RATE_LIMIT_WINDOW_SECONDS=60
MAX_TRANSCRIBE_CONTENT_LENGTH_BYTES=11534336
# Aggregate seconds across all clients in one running worker; resets on restart.
TRANSCRIBE_AUDIO_BUDGET_SECONDS=3600
TRANSCRIBE_AUDIO_BUDGET_WINDOW_SECONDS=86400
# Export in the server environment. Trust only verified ingress proxies, never '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
